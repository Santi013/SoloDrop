<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Приложение подключается к локальному серверу на вашем ПК для обмена сообщениями и файлами.</string>
    <key>NSCameraUsageDescription</key>
    <string>SoloDrop использует камеру, чтобы сканировать QR-код подключения.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp.</string>
    </array>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>SoloDrop сохраняет полученные изображения в вашу галерею, когда включено автосохранение.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.solodrop.app.sync</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>fetch</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
